    "CCGS-REVIEW": "https://github.com/Donchitos/Claude-Code-Game-Studios/blob/main/.claude/skills/design-review/SKILL.md",
    "CCGS-GAME-DESIGNER": "https://github.com/Donchitos/Claude-Code-Game-Studios/blob/main/.claude/agents/game-designer.md",
